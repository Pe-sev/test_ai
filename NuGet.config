<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- Projektet har enbart publika beroenden. <clear /> gör bygget oberoende av
       maskinens företagsfeeds, som annars fäller restore när de kräver inloggning. -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
